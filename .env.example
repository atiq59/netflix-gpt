# Firebase Configuration
# Get these values from your Firebase project settings
# https://firebase.google.com/docs/web/setup#create-firebase-project
VITE_FIREBASE_API_KEY="your_firebase_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="your_firebase_auth_domain_here"
VITE_FIREBASE_PROJECT_ID="your_firebase_project_id_here"
VITE_FIREBASE_STORAGE_BUCKET="your_firebase_storage_bucket_here"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_firebase_messaging_sender_id_here"
VITE_FIREBASE_APP_ID="your_firebase_app_id_here"
VITE_FIREBASE_MEASUREMENT_ID="your_firebase_measurement_id_here"

# OpenRouter API Key
# Sign up at https://openrouter.ai/ and create an API key
VITE_OPENROUTER_API_KEY="your_openrouter_api_key_here"

# TMDB (The Movie Database) API Key
# Get your API key from https://www.themoviedb.org/settings/api
# Use the read access token format: Bearer <your_token>
VITE_TMDB_KEY="Bearer your_tmdb_api_token_here"
